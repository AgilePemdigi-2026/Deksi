FROM python:3.14-slim

# poppler-utils sediakan `pdftotext` untuk ingest PDF KiTa dari /scraping.
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt ./requirements.txt
COPY backend/requirements-production.txt ./backend/requirements-production.txt
COPY backend/requirements-auth.txt ./backend/requirements-auth.txt
RUN pip install --no-cache-dir -r backend/requirements-production.txt

COPY backend/ ./backend/
WORKDIR /app/backend

EXPOSE 8000
CMD ["gunicorn", "backend.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "60"]
