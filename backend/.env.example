# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local development)
POSTGRES_DB=deksi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: set DATABASE_URL to override the POSTGRES_* values above.

# BPS WebAPI Configuration
# Get your API key from https://webapi.bps.go.id/developer/
BPS_API_KEY=your_bps_api_key_here
BPS_API_BASE_URL=https://webapi.bps.go.id/v1

# Timezone
TIME_ZONE=Asia/Jakarta