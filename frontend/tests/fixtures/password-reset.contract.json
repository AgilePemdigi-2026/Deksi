{
  "version": "DEKSI-RESET-1",
  "status": "CONTRACT_FOR_REVIEW_NOT_IMPLEMENTED",
  "scope": "Synthetic contract examples only; no endpoint execution, email delivery or database mutation",
  "routes": ["/admin/forgot-password", "/admin/reset-password", "/admin/login"],
  "proposedPolicy": {
    "eligible": "Exactly one case-insensitive email match among all users, then active staff with usable password",
    "tokenLifetimeSeconds": 1800,
    "requestBodyMaxBytes": 16384,
    "emailMaxCharacters": 254,
    "capabilityMaxCharactersPerField": 256,
    "passwordMaxCharactersPerField": 4096,
    "requestIpLimit": {"attempts": 20, "windowSeconds": 900},
    "requestIdentityLimit": {"attempts": 3, "windowSeconds": 900, "response": "same generic 202"},
    "checkConfirmIpLimit": {"attempts": 20, "windowSeconds": 900},
    "newPasswordMustDifferFromCurrent": true,
    "latestRequestOnly": false,
    "automaticLogin": false,
    "sharedLimiterSchema": "DECISION_PENDING_NO_MIGRATION_AUTHORIZED",
    "productionEmailDeliveryAndTiming": "DECISION_PENDING_NO_PROVIDER_OR_WORKER_AUTHORIZED"
  },
  "endpoints": [
    {
      "method": "POST", "path": "/api/auth/password-reset/request/",
      "request": {"email": "admin@example.test"},
      "response": {"status": 202, "body": {"code": "reset_request_accepted", "accepted": true}},
      "sameResponseFor": ["eligible", "unknown", "inactive", "nonstaff", "unusable", "ambiguous", "identity_throttled"]
    },
    {
      "method": "POST", "path": "/api/auth/password-reset/check/",
      "request": {"uid": "DEMO_ONLY", "token": "DEMO_ONLY"},
      "response": {"status": 200, "body": {"valid": true}},
      "nonConsuming": true
    },
    {
      "method": "POST", "path": "/api/auth/password-reset/confirm/",
      "request": {"uid": "DEMO_ONLY", "token": "DEMO_ONLY", "newPassword": "SYNTHETIC_ONLY_NOT_A_PASSWORD", "confirmPassword": "SYNTHETIC_ONLY_NOT_A_PASSWORD"},
      "response": {"status": 200, "body": {"code": "reset_complete", "authenticated": false}}
    }
  ],
  "errors": [
    {"status": 400, "body": {"code": "invalid_request"}},
    {"status": 400, "body": {"code": "invalid_reset_link"}},
    {"status": 400, "body": {"code": "password_validation_failed", "fields": {"newPassword": ["password_too_common"]}}},
    {"status": 403, "body": {"code": "csrf_failed"}},
    {"status": 413, "body": {"code": "request_too_large"}},
    {"status": 415, "body": {"code": "unsupported_media_type"}},
    {"status": 429, "body": {"code": "rate_limited"}},
    {"status": 503, "body": {"code": "reset_unavailable"}}
  ],
  "passwordFieldCodes": ["password_too_short", "password_too_common", "password_too_similar", "password_entirely_numeric", "password_unchanged", "password_mismatch"],
  "negativeCases": [
    {"id": "N01", "case": "empty/malformed/oversize/non-string email", "expected": "safe input failure; no user lookup leak"},
    {"id": "N02", "case": "unknown/inactive/nonstaff/unusable/ambiguous identity", "expected": "generic 202; no email"},
    {"id": "N03", "case": "identity-email throttle", "expected": "generic 202; no email; no Login lockout change"},
    {"id": "N04", "case": "IP throttle including concurrent processes", "expected": "429 using shared atomic state"},
    {"id": "N05", "case": "absent/stale CSRF or disallowed origin", "expected": "safe 403; no mutation"},
    {"id": "N06", "case": "malformed/expired/used/state-changed token", "expected": "generic invalid_reset_link; no account data"},
    {"id": "N07", "case": "GET/email scanner/repeated check", "expected": "never consumes token or changes password"},
    {"id": "N08", "case": "password mismatch/native validator/unchanged password", "expected": "allowlisted field codes; no mutation"},
    {"id": "N09", "case": "two simultaneous confirms for one token", "expected": "exactly one successful commit on actual supported engine"},
    {"id": "N10", "case": "old cookie/password after successful reset", "expected": "API and Django Admin reject; no automatic login"},
    {"id": "N11", "case": "HTML/oversize/malformed JSON/network/ambiguous confirm", "expected": "no fake success and no automatic POST replay"},
    {"id": "N12", "case": "untrusted Host/Origin/next value", "expected": "link still uses trusted configured frontend HTTPS origin"},
    {"id": "N13", "case": "email provider failure for one target", "expected": "same generic request response; safe internal observability"},
    {"id": "N14", "case": "exception/report/log/referrer/browser history", "expected": "no raw capability/password/email body in retained evidence"},
    {"id": "N15", "case": "new fragment on mounted reset page/reload/back", "expected": "revalidate new fragment; cleared capability is not resurrected from storage"},
    {"id": "N16", "case": "unknown/global email delivery timing", "expected": "production gate remains blocked without measured async/shared safeguards"}
  ]
}
