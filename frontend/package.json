{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/editorial.test.mjs",
    "test:source-dialog": "node tests/admin-source-dialog.browser.mjs",
    "test:resync": "node --test tests/resync-action.test.mjs tests/resync-contract.test.mjs tests/online-resync.test.mjs",
    "test:resync:browser": "node tests/resync-action.browser.mjs",
    "test:resync:integration": "python tests/run-online-browser.py",
    "test:indicators": "node --test tests/indicator-data.test.mjs tests/indicator-api.test.mjs tests/indicator-pages.test.mjs",
    "test:indicators:browser": "node tests/indicator-browser.test.mjs",
    "test:source-trace": "node --test tests/source-trace.test.mjs",
    "test:ai-narratives": "node --test tests/ai-narratives-client.test.mjs",
    "test:source-trace:browser": "node tests/indicator-browser.test.mjs --source-trace",
    "test:economic-engine": "node --test tests/economic-engine.test.mjs",
    "test:economic-engine:browser": "node tests/economic-engine.browser.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:sprint-1": "node --test tests/dashboard-client.test.mjs tests/dashboard-routes.test.mjs tests/auth.test.mjs tests/password-reset.test.mjs tests/recoveryClient.test.mjs tests/indicator-api.test.mjs tests/indicator-data.test.mjs tests/indicator-pages.test.mjs tests/source-trace.test.mjs",
    "test:dashboard": "node --test tests/dashboard-client.test.mjs tests/dashboard-routes.test.mjs tests/batch2-range-calendar.test.mjs tests/browser-guard.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
