{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/editorial.test.mjs",
    "test:indicators": "node --test tests/indicator-data.test.mjs tests/indicator-api.test.mjs tests/indicator-pages.test.mjs",
    "test:indicators:browser": "node tests/indicator-browser.test.mjs",
    "test:source-trace": "node --test tests/source-trace.test.mjs",
    "test:source-trace:browser": "node tests/indicator-browser.test.mjs --source-trace",
    "test:browser": "node tests/browser.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
